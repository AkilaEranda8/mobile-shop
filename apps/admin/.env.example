# Enterprise Admin API (existing)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/admin/v1

# Hub proxies — Fashion ERP + Salon (server-side; do not expose secrets to browser)
