{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node16",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/database/_*.ts",
    "src/database/seed*.ts",
    "src/database/merge-*.ts",
    "src/modules/emi-locker/phase*.ts",
    "src/modules/emi-locker/phase*.mjs",
    "src/modules/emi-locker/**/*.test.ts",
    "src/modules/emi-locker/**/*.acceptance.ts"
  ]
}
